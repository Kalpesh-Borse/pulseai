# OpenAI API key — required for classification and summary generation.
OPENAI_API_KEY=sk-your-key-here

# Model used for structured per-item classification (JSON mode).
CLASSIFIER_MODEL=gpt-4o-mini

# Model used for the narrative weekly summary.
SUMMARY_MODEL=gpt-4o-mini

# Sampling temperature — kept at 0 across the app for deterministic, repeatable output.
MODEL_TEMPERATURE=0

# Max characters accepted per feedback item before truncation/rejection.
MAX_FEEDBACK_LENGTH=4000

# Cosine-distance threshold below which two feedback embeddings are considered the same theme cluster.
THEME_CLUSTER_DISTANCE_THRESHOLD=0.35

# Directory where the local ChromaDB persistent store is written.
CHROMA_PERSIST_DIR=./chroma_db

# Number of top theme clusters to surface in the aggregate report / dashboard.
TOP_THEME_COUNT=8

# Path to the local SQLite database file that stores classified items and weekly reports
# (grouped by ISO calendar week), enabling the calendar/week browsing UI.
DATABASE_PATH=./pulseai.db
